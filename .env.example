# Bot Configuration
MELPO_TOKEN=your_bot_token_here
MELPO_ID=your_bot_id_here
GUILDID=your_guild_id_here # For development only, not required for production
PREMIUM_SKU_ID=your_premium_sku_id_here # To link Melpo's Discord store, not needed other than for Melpo itself.

ENCRYPTION_KEY=your_encryption_key_here # 64 characters in hex: Must be 32 bytes long for AES-256 encryption.

POST_STATS=false

# Image server
S3ACCOUNT_ID = 
S3BUCKET_NAME = 
S3ACCESS_KEY_ID = 
S3SECRET_ACCESS_KEY = 
S3ENDPOINT = 
S3PUBLIC_BASE_URL =

# Postgresql Database Configuration
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_HOST=your_database_host
DB_PORT=your_database_port